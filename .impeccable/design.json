    {
      "name": "Primary download",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Windows download action with hover lift and press feedback.",
      "html": "<a class=\"ds-download\" href=\"#download\"><svg class=\"ds-win-logo\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M0 0h7.5v7.5H0zM8.5 0H16v7.5H8.5zM0 8.5h7.5V16H0zM8.5 8.5H16V16H8.5z\"/></svg>Download for Windows</a>",
      "css": ".ds-download{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:52px;background:linear-gradient(#3a3a3a,#1f1f1f);color:#fff;padding:14px 26px;border-radius:12px;text-decoration:none;font-size:15px;font-weight:600;white-space:nowrap;box-shadow:inset 0 1px 0 #ffffff26,0 1px 2px #0003,0 8px 24px -8px #0006;transition:transform .15s,box-shadow .15s;font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-download:hover{color:white;transform:translateY(-1px);box-shadow:inset 0 1px 0 #ffffff26,0 2px 4px #0003,0 14px 30px -10px #0007;}.ds-download:active{transform:none;background:#111;}.ds-win-logo{width:16px;height:16px;fill:currentColor;}.ds-download:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}"
    },
    {
      "name": "Copy button",
      "kind": "button",
      "refersTo": "copy-button",
      "description": "Secondary action beside the selectable command.",
      "html": "<button class=\"ds-copy\" type=\"button\">Copy</button>",
      "css": ".ds-copy{margin-left:auto;padding:7px 12px;border:1px solid #ccc;border-radius:4px;background:white;cursor:pointer;font:inherit;font-size:13px;color:#202020;font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-copy:hover{background:#f7f7f7;}.ds-copy:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact GitHub navigation link.",
