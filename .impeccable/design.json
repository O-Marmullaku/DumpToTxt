      "html": "<a class=\"ds-card\" href=\"#compact\"><b>Compact <span aria-hidden=\"true\">↓</span></b><span>The same app, smaller download. Only works if the Microsoft .NET 8 Desktop Runtime is already on your PC.</span></a>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:6px;padding:16px 18px;border:1px solid #dcdcdc;border-radius:8px;background:#fff;text-decoration:none;font-size:13px;line-height:1.5;color:#515151;font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-card b{display:flex;align-items:center;gap:8px;font-size:16px;color:#1a1a1a;}.ds-card b span{margin-left:auto;}.ds-card:hover{border-color:#999;color:#515151;}.ds-card:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}"
    },
    {
      "name": "Recommended download card",
      "kind": "card",
      "refersTo": "download-card-recommended",
      "description": "Full with its badge in the aligned title row.",
