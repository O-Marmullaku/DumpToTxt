      "css": ".ds-nav{display:flex;gap:28px;font-size:14px;font-family:\"Segoe UI\",system-ui,sans-serif;color:#202020;}.ds-nav a{text-decoration:none;color:inherit;}.ds-nav a:hover{color:#1967d2;}.ds-nav a:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}"
