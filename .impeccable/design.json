      "css": ".ds-card{display:flex;flex-direction:column;gap:6px;padding:16px 18px;border:1px solid #dcdcdc;border-radius:8px;background:#fff;text-decoration:none;font-size:13px;line-height:1.5;color:#515151;font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-card b{display:flex;align-items:center;gap:8px;font-size:16px;color:#1a1a1a;}.ds-card b span{margin-left:auto;}.ds-card:hover{border-color:#999;color:#515151;}.ds-card:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}.ds-card.ds-card-main{background:#2d2d2d;border-color:#2d2d2d;color:#cfcfcf;}.ds-card.ds-card-main b{color:#fff;}.ds-badge{white-space:nowrap;padding:2px 8px;border-radius:99px;background:#ffffff1f;color:#fff;font-size:11px;font-weight:600;line-height:1.5;font-style:normal;font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-card.ds-card-main:hover{background:#444;color:#cfcfcf;}"
    },
    {
