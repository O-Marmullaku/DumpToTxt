      "description": "PowerShell label, selectable command and Copy control.",
      "html": "<div class=\"ds-command\"><span class=\"ds-ps\">PowerShell</span><code>irm https://dumptotxt.com/install.ps1 | iex</code><button class=\"ds-copy\" type=\"button\">Copy</button></div>",
      "css": ".ds-command{display:flex;align-items:center;gap:16px;padding:14px 16px;background:#eaeaea;margin-top:20px;border-radius:6px;font-family:\"Segoe UI\",system-ui,sans-serif;color:#202020;}.ds-command .ds-ps{flex:none;font-size:12px;font-weight:600;color:var(--muted,#626262);}.ds-command code{font:13px/1.6 Consolas,monospace;overflow-wrap:anywhere;user-select:all;}.ds-copy{margin-left:auto;padding:7px 12px;border:1px solid #ccc;border-radius:4px;background:white;cursor:pointer;font:inherit;font-size:13px;color:#202020;font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-copy:hover{background:#f7f7f7;}.ds-copy:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}"
    }
