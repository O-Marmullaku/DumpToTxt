      "html": "<button class=\"ds-step\" type=\"button\"><span>1</span>Right-click in Explorer</button>",
      "css": ".ds-step{display:flex;align-items:center;gap:10px;border:0;padding:2px 0;background:none;font:inherit;color:inherit;text-align:left;cursor:pointer;font-family:\"Segoe UI\",system-ui,sans-serif;font-size:16px;font-weight:600;line-height:1.15;letter-spacing:0;color:var(--muted,#626262);}.ds-step>span{font-size:12px;border:1px solid #aaa;border-radius:50%;width:24px;height:24px;display:grid;place-items:center;flex-shrink:0;transition:background .4s,color .4s,border-color .4s;}.ds-step:focus-visible{outline:3px solid var(--focus,#1967d2);outline-offset:4px}"
    },
